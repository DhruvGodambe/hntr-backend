# hntr-backend environment configuration.
# Copy this file to `.env` and fill in real values before running the server.
#
# NOTE: src/config/env.ts also auto-loads ../hntr/.env first, so USDT_ADDRESS,
# USDC_ADDRESS and SEPOLIA_RPC_URL are already inherited from the contracts
# workspace's .env if you deployed from there - you only need to duplicate
# them here if you want this backend to point somewhere different.

PORT=8000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/hntr

# RPC endpoint for the chain the contract is deployed on
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# HNTRMembership contract address (from `forge script ... --broadcast` output)
CONTRACT_ADDRESS=

# Only needed if this backend should use different tokens than hntr/.env
USDT_ADDRESS=
USDC_ADDRESS=

# Long random string used to sign session JWTs. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string

# Session/nonce lifetimes (seconds)
AUTH_TOKEN_TTL_SECONDS=86400
AUTH_NONCE_TTL_SECONDS=300

# Etherscan v2 unified API - used instead of raw eth_getLogs for historical event
# queries, since most public RPC nodes reject eth_getLogs over any non-trivial
# block range ("Archive requests require a personal token"). Already inherited
# from hntr/.env if you deployed from there.
ETHERSCAN_API_KEY=
ETHERSCAN_CHAIN_ID=11155111
# Block the contract was deployed at, to avoid scanning from block 0 (from the
# `forge script ... --broadcast` output). Update this on each membership redeploy.
CONTRACT_DEPLOY_BLOCK=0

# Optional: earliest block for admin wallet ledgers (ERC20 transfers into company/
# leadership/…). Defaults to 0 so history survives membership redeploys. Do not
# point this at the latest CONTRACT_DEPLOY_BLOCK or prior-contract inflows vanish.
# LEDGER_FROM_BLOCK=0

# The security wallet (getUnclaimedWallets / withdrawUnclaimed) needs NO backend key:
# the listing is a read-only eth_call, and the admin connects the security wallet in
# the admin UI to sign withdrawUnclaimed. Keep its key in a secrets manager only.

# Private key that controls `burnerWallet` on-chain. The burner:
# - sends `redeemVoucher` (gift-code redeemers never sign a tx or need ETH)
# - signs purchase/upgrade commission-auth payloads (it is the on-chain authorized
#   signer, auto-enrolled by setBurnerWallet)
# - calls `overrideMembershipTier` for admin free-membership overrides
# - pays leadership/rank/pool disbursements to members (the admin funds it first by
#   connecting the leadership/rank/pool wallet and transferring USDT/USDC to it)
# Holds ETH for gas + the disbursement float — never leave tokens idle otherwise.
BURNER_WALLET_PRIVATE_KEY=
# Expected burner address; checked against on-chain burnerWallet() at startup.
BURNER_WALLET=
# Alert threshold (ETH) for burner gas; the voucher cron warns below this.
BURNER_MIN_ETH=0.02
# How long a voucher may sit in REDEEMING before the cron returns it to ACTIVE (ms).
VOUCHER_REDEEM_LOCK_TTL_MS=600000
# HMAC pepper for the voucher-code lookup hash. Rotating it invalidates every
# outstanding code — treat as fixed for the life of the deployment. Use a long random string.
VOUCHER_CODE_PEPPER=
# AES-256-GCM key for encrypting voucher plaintext at rest: 32 bytes as 64 hex chars
# (or base64). Generate: openssl rand -hex 32
VOUCHER_CODE_ENC_KEY=
# Public base URL of the Next.js app, used to build shareable /redeem links.
APP_BASE_URL=http://localhost:3000

# Shared secret required (via an `x-admin-secret` header) to call protected
# /api/admin routes that move real funds, e.g. POST /api/admin/run-leadership-payout
# or POST /api/admin/run-achievement-payout. Leave empty to keep those routes disabled.
ADMIN_SECRET=

# Password for the admin panel web UI (POST /api/admin/auth/login).
# Legacy fallback when login is sent without a username. Prefer DB-backed admin accounts.
ADMIN_PASSWORD=

# Enable database-backed admin username/password auth (default: true).
ADMIN_DB_AUTH=true

# Secret required (x-admin-setup-secret header) to create admin accounts after the first bootstrap account.
# POST /api/admin/auth/register { "username": "...", "password": "..." }
ADMIN_SETUP_SECRET=

# Admin session JWT lifetime (seconds). Default: 1 hour.
ADMIN_TOKEN_TTL_SECONDS=3600

# Cloudflare Turnstile — server-side "verify you are human" check on POST
# /api/admin/auth/login, /api/admin/auth/register and /api/users/register.
# Get the Secret Key from: Cloudflare dashboard -> Turnstile -> (your widget).
# Leave empty to disable the check (local dev, Postman, CI). The matching public
# Site Key goes in the frontend as NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET=

# CoinGecko Demo (CG-…) or Pro API key. Used by GET /api/market/coingecko.
# Demo: https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# Mongo cache TTL for successful CoinGecko responses (ms). Concurrent users within
# this window are served from DB so we do not stampede CoinGecko rate limits.
# Default: 120000 (2 minutes).
COINGECKO_CACHE_TTL_MS=120000

# OpenSea API key. Used by GET/POST /api/market/opensea.
# https://docs.opensea.io/reference/getting-your-api-key
OPENSEA_API_KEY=

# Gift codes: HMAC pepper + AES-256-GCM key (32 bytes as hex or base64). REQUIRED
# on the backend Render service for issue/reveal. Do not wrap values in quotes.
VOUCHER_CODE_PEPPER=
VOUCHER_CODE_ENC_KEY=

# Frontend origin used when building /redeem?code=… share links.
APP_BASE_URL=http://localhost:3000

# Redeem attempt lock TTL before voucher-cron releases stale locks (ms). Default 10m.
VOUCHER_REDEEM_LOCK_TTL_MS=600000

# Burner wallet (voucher membership funding / disbursements). From setup-burner script.
BURNER_WALLET=
BURNER_WALLET_PRIVATE_KEY=
BURNER_MIN_ETH=0.02
